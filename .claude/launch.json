{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Streamlit UI (app.py)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "stlite static (index.html)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8502"],
      "port": 8502
    }
  ]
}
